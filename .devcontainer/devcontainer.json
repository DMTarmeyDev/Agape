{
  "name": "Agape V5.6.1 R2.5.1",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [
    8850,
    8851,
    8852
  ],
  "portsAttributes": {
    "8850": {
      "label": "Agape Mainframe",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8851": {
      "label": "Agape Document Studio",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "8852": {
      "label": "Agape Workflow Bridge",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install -U pip pytest && python -m pip install -r requirements-runtime.txt && python -m compileall -q agape_mainframe main.py SETUP-API-KEYS.py && python scripts/check_repository_links.py",
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
